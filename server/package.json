{
  "name": "onehouse-api",
  "version": "0.1.0",
  "private": true,
  "description": "한지붕 가계부 API (Cloudflare Workers + D1)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply onehouse --local",
    "db:migrate:remote": "wrangler d1 migrations apply onehouse --remote",
    "test:smoke": "node test/smoke.mjs && node test/memo-smoke.mjs",
    "test:smoke:memo": "node test/memo-smoke.mjs",
    "test:unit": "node --experimental-strip-types --no-warnings --test test/merge.test.ts",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.154.0"
  }
}
